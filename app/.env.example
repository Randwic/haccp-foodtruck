# Copier en .env.local puis renseigner (Supabase → Project Settings → API).
# Sans ces valeurs, l'app tourne avec un serveur simulé en mémoire (démo).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Nouvelle clé publique (Supabase → Project Settings → API Keys → « Publishable key », sb_publishable_…).
# Si elle est renseignée, elle remplace VITE_SUPABASE_ANON_KEY (ancienne clé, retirée par Supabase début 2027).
VITE_SUPABASE_PUBLISHABLE_KEY=
